<!DOCTYPE html>
<html>
    <head>
        <title>
            Counter
        </title>
    </head>
    <style>
        body{
            text-align: center;
        }
        div{
            background-color: black;
            height: 40px;
            width: 120px;
            color:aliceblue;
            border: 1px solid black;
            border-radius: 14px;
            padding: 1px;
            margin:auto;
        }
        p{
            background-color: aliceblue;
            border: 1px solid aliceblue;
            border-radius: 14px;
            color:black;
            height: 35px;
            width: 100px;
            font-size:150%;
            text-align: center;
            margin:auto;
            padding: 1px;
        }
    </style>
    <body>
        <h1>
            COUNTER
        </h1>
        <div id="counter">
            <p id="count">
                0
            </p>
        </div>
                  <button onclick="increase()">
                +
            </button>
            <button onclick="decrease()">
                -
            </button>
            <button onclick="reset()">
                Reset
            </button>
        <script>
            let count = 0;

            function increase(){
               count++;
               document.getElementById("count").innerHTML = count;
            }

            function decrease(){
                count--;
                document.getElementById("count").innerHTML = count;
            }

            function reset(){
                count = 0;
                document.getElementById("count").innerHTML = count;
            }
        </script>
    </body>
</html>
