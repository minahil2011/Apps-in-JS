<!DOCTYPE html>
<html>
    <head>
        <title>
            Rolling Dice app
        </title>
        <style>
            body{
                text-align:center;
                font-family:cursive;
            }
            #dice{
                font-size: 320px;
            }
            #dice:hover{
                cursor: pointer;
            }
        </style>
    </head>
    <body>
        <div>
            <h1>
                Click on the dice...
            </h1>
        </div>
        <div id="dice" onclick="stopStart()"></div>
        <script>
            //dice images
            var dices = ['&#9856;', '&#9857;', '&#9858;', '&#9859;', '&#9860;', '&#9861;'];
            var stopped = true;
            //change dice emojis
            function change(){
                var random = Math.floor(Math.random()* 6);
                dice.innerHTML = dices[random];
            }

            function stopStart(){
                if(stopped){
                    stopped = false
                    t = setInterval(change, 100);
                }
                else{
                    clearInterval(t);
                    stopped = true;
                }
            }
            //invoking function
            window.onload = function(){
                dice = document.getElementById("dice");
                stopStart();
            }
        </script>
    </body>
</html>
